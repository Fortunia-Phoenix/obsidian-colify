{
	"name": "colify",
	"version": "0.1.2",
	"description": "Create and edit visual Markdown column layouts in Live Preview and Reading View.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs --watch",
		"lint": "eslint .",
		"test": "node scripts/core-regression.mjs && node scripts/deploy-local.test.mjs",
		"build": "tsc --noEmit && node scripts/core-regression.mjs && node esbuild.config.mjs production",
		"deploy:local": "npm run build && node scripts/deploy-local.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"columns",
		"live-preview"
	],
	"author": "Qismet",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fortunia-Phoenix/obsidian-colify.git"
	},
	"homepage": "https://github.com/Fortunia-Phoenix/obsidian-colify#readme",
	"bugs": {
		"url": "https://github.com/Fortunia-Phoenix/obsidian-colify/issues"
	},
	"devDependencies": {
		"@codemirror/commands": "6.8.1",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@types/node": "^20.11.30",
		"esbuild": "^0.20.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "^1.5.12",
		"typescript": "^5.4.3",
		"typescript-eslint": "^8.65.0"
	}
}
